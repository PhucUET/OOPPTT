<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="stack_root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="unknown.oopptt.controller.MainMenuController">
   <children>
      <ImageView fx:id="menubackground" fitHeight="500.0" fitWidth="600.0" pickOnBounds="true" preserveRatio="true" />

      <AnchorPane focusTraversable="true" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0">
         <children>
            <VBox alignment="CENTER" layoutX="89.0" layoutY="151.0" prefHeight="229.0" prefWidth="402.0" spacing="16.0">
               <children>
                  <Button fx:id="btnAdventure" mnemonicParsing="false" onAction="#onAdventure" prefHeight="40.0" prefWidth="206.0" text="ADVENTURE">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets></Button>
                  <Button fx:id="btnBattle" mnemonicParsing="false" nodeOrientation="LEFT_TO_RIGHT" onAction="#onBattle" prefHeight="40.0" prefWidth="206.0" text="BATTLE" />
                  <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="206.0" text="Button" />
                  <Button fx:id="btnExit" mnemonicParsing="false" onAction="#onExit" prefHeight="40.0" prefWidth="207.0" text="EXIT" />
               </children>
            </VBox>
            <VBox layoutX="107.0" layoutY="48.0" prefHeight="103.0" prefWidth="385.0">
               <children>
                  <ImageView fitHeight="118.0" fitWidth="384.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../graphic/BG.png" />
                     </image>
                  </ImageView>
               </children>
            </VBox>
         </children>
      </AnchorPane>
   </children>
</StackPane>
