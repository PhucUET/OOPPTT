<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.media.MediaView?>

<StackPane fx:id="stack_root" prefHeight="650.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="unknown.oopptt.controller.GameScreen_controller">
   <children>
      <MediaView fx:id="mediaView" nodeOrientation="INHERIT" />
      <ImageView fx:id="gameBackground" pickOnBounds="true" preserveRatio="true" />
      <AnchorPane fx:id="gamePane" nodeOrientation="INHERIT" prefHeight="650.0" prefWidth="600.0" StackPane.alignment="CENTER">
         <children>
            <Pane fx:id="layout_game" prefHeight="650.0" prefWidth="600.0">
               <children>
                   <ImageView fx:id="paddle"  pickOnBounds="true" preserveRatio="true" />
                   <ImageView fx:id="ball"  pickOnBounds="true" preserveRatio="true" />
               </children>
            </Pane>
         </children>
      </AnchorPane>


   </children>
</StackPane>
